{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "bash .claude/hooks/no-ticket-refs.sh",
            "timeout": 10,
            "statusMessage": "Checking for leaked ticket IDs..."
          }
        ]
      }
    ]
  }
}
